# Modèle de configuration : copier ce fichier en .env puis le remplir.
# Le vrai .env n'est JAMAIS commité (il est dans .gitignore).

# Clé API Last.fm (https://www.last.fm/api/account/create)
LASTFM_API_KEY=ta_cle_ici
# Ton pseudo Last.fm
LASTFM_USER=ton_pseudo
# Durée du cache en secondes
CACHE_TTL_SECONDS=60
# Port du serveur
PORT=3000
# Pour simuler une panne de Last.fm pendant la démo, décommenter la ligne suivante :
# LASTFM_BASE_URL=https://adresse-invalide.example/
